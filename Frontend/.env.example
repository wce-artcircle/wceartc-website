# ──────────────────────────────────────────────────────────────────────────────
# WCE Art Circle — Vite environment variables
# Copy this file to `.env` and fill in the real values.
# NEVER commit `.env` — it is in .gitignore.
# ──────────────────────────────────────────────────────────────────────────────

# Backend registration API endpoint (Express + MongoDB)
# Example: https://your-backend.onrender.com/register
# Leave empty during local dev to skip the API call and show the success state.
# NOTE: the URL recovered from git history (https://artc-website-production.up.railway.app/register)
# returns 404 for every request as of Nov 2026 — the Railway service appears dead.
# Ask the team for the current backend URL, or deploy Backend/ fresh (needs MONGO_URI).
VITE_REGISTER_API=

# Optional: Razorpay public key (for future payment integration)
# VITE_RAZORPAY_KEY=
